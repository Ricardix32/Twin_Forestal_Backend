# Base de Datos
DATABASE_URL=postgresql+psycopg://silvatwin_user:silvatwin_secret@localhost:5432/silvatwin
# Si es True y PostgreSQL no responde, usa SQLite local (silvatwin.db) temporalmente para desarrollo
SQLITE_FALLBACK=True

# Google Gemini API
GEMINI_API_KEY=""

# Configuración del Servidor
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
